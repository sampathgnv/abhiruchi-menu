  "highlights": [
    {
      "id": "kaja",
      "name": "Kaja",
      "itemId": "kakinada-kaja",
      "description": "Made using refined wheat flour, sugar syrup (paakam), and edible oils, our Kaja is one of the finest customers can find in and around Visakhapatnam."
    },
    {
      "id": "bobbatlu",
      "name": "Bobbatlu",
      "itemId": "bobbatlu",
      "description": "Puran Poli, popularly called \"Bobbattu\", is one of the famous sweets found in Coastal Andhra Pradesh, majorly served during festivals and special occasions. Our Bobbattu stands as one of the finest sweets that we offer in our stores."
    },
    {
      "id": "ariselu",
      "name": "Ariselu",
      "itemId": "ariselu",
      "description": "A primary home food during the festival of Sankranti in Andhra Pradesh, our Ariselu are ordered by many of our clients during the festival season, who adore its suavity."
    },
    {
      "id": "kova-billalu",
      "name": "Kova Billalu (White)",
      "itemId": "kova-billalu-white",
      "description": "Popularly known as Khoa in North India, Kova is a dairy product sold in many forms. Our stores have Kova in various forms like Pedha (billalu), Barfi and Halwa."
    },
    {
      "id": "jangri",
      "name": "Jangri",
      "itemId": "jangri",
      "description": "Saffron coloured Jangri, made from Jangri Black Gram found in the Indian subcontinent, is available in our stores all round the year."
    },
    {
      "id": "chekkalu",
      "name": "Chekkalu",
      "itemId": "chekkalu",
      "description": "Rice Crackers (Chekkalu) are one of the most sought after home foods during the festival of Makara Sankranti. They are sought out by our clients primarily during the festival season, and all round the year too."
    }
  ],
